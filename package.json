{
  "name": "playroom",
  "description": "A playroom of small web games for young kids, to play alone or with a grown-up.",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "workspaces": [
    "portal",
    "games/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev -w @playroom/portal",
    "build": "node scripts/build-site.mjs",
    "preview": "vite preview --outDir dist --port 5179 --strictPort",
    "test": "npm test --workspaces --if-present && node --test scripts/voice/lib.test.mjs",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "voice": "node scripts/voice/voice.mjs generate",
    "voice:setup": "sh scripts/voice/setup.sh",
    "voice:words": "node scripts/voice/voice.mjs words",
    "voice:fix": "node scripts/voice/voice.mjs fix"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "~7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
